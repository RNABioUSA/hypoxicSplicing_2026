# Copy this file to negative_control.env, then replace the placeholder paths.

# This companion workflow directory.
WORKFLOW_ROOT=/absolute/path/to/normoxia_negative_control

# An isolated output directory. Do not point this at the main manuscript results.
OUTPUT_ROOT=/absolute/path/to/normoxia_negative_control_output

# Use exactly the same GENCODE v45 GTF and indices as the manuscript analysis.
GTF=/absolute/path/to/gencode.v45.annotation.gtf
SALMON_INDEX=/absolute/path/to/existing/gencode_v45_salmon_index
STAR_INDEX=/absolute/path/to/existing/gencode_v45_star_index

THREADS=8
N_PERM=20
SEED=20260727
ALPHA=0.10

# Usually suppa.py. An absolute path is also accepted.
SUPPA_PY=suppa.py
